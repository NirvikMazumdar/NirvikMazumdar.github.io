---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import GitHubActivity from './GitHubActivity.astro';
import { copy, getProfile, getSkillHref, type Locale } from '../data/profile';
interface Props { locale: Locale }
const { locale } = Astro.props;
const text = copy[locale];
const profile = getProfile(locale);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section class="hero">
  <div class="hero__glow hero__glow--1" aria-hidden="true"></div><div class="hero__glow hero__glow--2" aria-hidden="true"></div>
  <div class="container hero__grid"><div class="hero__text"><p class="mono hero__loc">{profile.location}</p><h1 class="hero__title"><span class="gradient-text">{text.headline}</span></h1><p class="hero__tagline muted">{text.tagline}</p><div class="hero__actions"><a class="btn btn--primary" href={profile.cv} target="_blank" rel="noopener">{text.labels.downloadCv} <span aria-hidden="true">↓</span></a>{profile.links.map((link) => <a class="btn btn--ghost" href={link.href} target="_blank" rel="noopener">{link.label} <span aria-hidden="true">↗</span></a>)}</div><ul class="hero__proof">{text.highlights.map((item) => <li><a href="#projects"><strong>{item.value}</strong><span>{item.label}</span></a></li>)}</ul><a class="hero__scroll mono" href="#projects">{text.explore} <span aria-hidden="true">↓</span></a></div><div class="hero__frame"><img class="hero__photo" src={profile.photo} alt={`Portrait of ${profile.name}`} width="480" height="640" /></div></div>
</section>
<Section id="about" index="01" label={text.labels.about}><p class="lead">{text.summary}</p><div class="focus" aria-label="Professional focus">{text.focus.map((item) => <div><p class="mono">{item.label}</p><p>{item.text}</p></div>)}</div><p class="mono stack-label">{text.labels.primaryStack}</p><ul class="chips">{profile.stack.map((item) => <li><a class="tag" href={getSkillHref(item)}>{item}</a></li>)}</ul></Section>
<Section id="experience" index="02" label={text.labels.experience}><ul class="timeline">{profile.experience.map((job) => <li class="entry"><div class="entry__head"><div><h3>{job.role}</h3><p class="muted">{job.org}</p></div><p class="mono entry__when">{job.period}<br />{job.location}</p></div><ul class="bullets">{job.bullets.map((item) => <li>{item}</li>)}</ul><ul class="chips">{job.tools.map((item) => <li><a class="tag" href={getSkillHref(item)}>{item}</a></li>)}</ul></li>)}</ul></Section>
<Section id="projects" index="03" label={text.labels.projects}><div class="cards">{projects.map((project) => <ProjectCard project={project} />)}</div></Section>
<Section id="activity" index="04" label="GitHub"><GitHubActivity /></Section>
<Section id="education" index="05" label={text.labels.education}><ul class="timeline">{profile.education.map((item) => <li class="entry"><div class="entry__head"><div><h3>{item.degree}</h3><p class="muted">{item.school}</p></div><p class="mono entry__when">{item.period}</p></div>{item.notes.length > 0 && <ul class="bullets">{item.notes.map((note) => <li>{note}</li>)}</ul>}</li>)}</ul></Section>
<Section id="skills" index="06" label={text.labels.skills}><dl class="skills">{profile.skills.map((item) => <div class="skills__row"><dt class="mono">{item.group}</dt><dd>{item.items.join(' · ')}</dd></div>)}</dl></Section>
<Section id="more" index="07" label={text.labels.more}><div class="more"><div class="more__panel"><p class="mono">{text.labels.languages}</p><ul class="plain plain--languages">{profile.languages.map((item) => <li><span>{item.name}</span><span class:list={['more__level', { 'more__level--fluent': !item.level.startsWith('A2') }]}>{item.level}</span></li>)}</ul></div><div class="more__panel"><p class="mono">{text.labels.achievements}</p><ul class="plain">{profile.achievements.map((item) => <li>{item}</li>)}</ul></div><div class="more__panel"><p class="mono">{text.labels.interests}</p><ul class="plain">{profile.interests.map((item) => <li>{item}</li>)}</ul></div></div></Section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: var(--sp-8) var(--sp-7); }.hero__glow { display: none; }.hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--sp-6); align-items: center; }.hero__text { animation: rise 500ms var(--ease) both; }.hero__frame { animation: rise 500ms var(--ease) 100ms both; } @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }.hero__loc { color: var(--accent); }.hero__title { font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.05; letter-spacing: -.03em; margin-block: var(--sp-3) var(--sp-4); max-width: 16ch; }.hero__tagline { font-size: clamp(1.125rem, 2vw, 1.375rem); line-height: 1.4; max-width: 40ch; }.hero__actions { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-6); }.hero__frame { position: relative; justify-self: end; width: 100%; max-width: 22rem; }.hero__frame::before { content: ''; position: absolute; inset: 0; transform: translate(0.75rem, 0.75rem); background: #a7f3b5; z-index: -1; }.hero__photo { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 72%; }
  .hero__proof { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: var(--sp-6); max-width: 44rem; background: var(--border); border: 1px solid var(--border); animation: rise 600ms var(--ease) 220ms both; }.hero__proof li { background: var(--bg); }.hero__proof a { position: relative; display: grid; gap: var(--sp-1); height: 100%; padding: var(--sp-3); overflow: hidden; transition: background var(--dur) var(--ease), transform var(--dur) var(--ease); }.hero__proof a::after { content: '↘'; position: absolute; right: var(--sp-3); bottom: var(--sp-3); color: var(--accent); opacity: 0; transform: translate(-.25rem, -.25rem); transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease); }.hero__proof a:hover, .hero__proof a:focus-visible { background: var(--accent-tint); transform: translateY(-3px); }.hero__proof a:hover::after, .hero__proof a:focus-visible::after { opacity: 1; transform: none; }.hero__proof strong { color: var(--accent); font-size: 1.125rem; letter-spacing: -.02em; }.hero__proof span { color: var(--text-2); font-size: .8125rem; line-height: 1.35; }.hero__scroll { display: inline-flex; gap: var(--sp-2); margin-top: var(--sp-4); color: var(--text-2); }.hero__scroll:hover { color: var(--accent); }.lead { font-size: clamp(1.125rem, 1.6vw, 1.375rem); line-height: 1.5; max-width: 44rem; }.focus { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-3); margin-top: var(--sp-5); }.focus > div { min-height: 10rem; padding: var(--sp-4); border-top: 3px solid var(--accent); background: var(--bg-layer); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }.focus > div:hover { transform: translateY(-4px); box-shadow: var(--shadow); }.focus .mono { margin-bottom: var(--sp-2); }.focus p:last-child { color: var(--text-2); font-size: .9375rem; }.stack-label { margin-top: var(--sp-6); margin-bottom: var(--sp-2); }.chips { display: flex; flex-wrap: wrap; gap: var(--sp-1); }.timeline { display: flex; flex-direction: column; gap: var(--sp-6); }.entry { display: flex; flex-direction: column; gap: var(--sp-3); padding-left: var(--sp-4); border-left: 2px solid var(--border); transition: border-color var(--dur) var(--ease); }.entry:hover { border-left-color: var(--accent); }.entry__head { display: flex; justify-content: space-between; gap: var(--sp-4); }.entry__head h3 { font-size: 1.25rem; }.entry__when { text-align: right; flex: none; line-height: 1.6; }.bullets { list-style: disc; padding-left: 1.25rem; color: var(--text-2); display: flex; flex-direction: column; gap: var(--sp-1); max-width: 44rem; }.cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); }.skills { margin: 0; }.skills__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--sp-3); padding: var(--sp-3) var(--sp-2); border-bottom: 1px solid var(--border); }.skills__row:hover { background: var(--accent-tint); }.skills__row:hover dt { color: var(--accent); }.skills__row:first-child { border-top: 1px solid var(--border); }.skills dt { align-self: center; }.skills dd { margin: 0; }.more { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5); }.plain { display: flex; flex-direction: column; gap: var(--sp-1); margin-top: var(--sp-2); } @media (max-width: 768px) { .hero { padding-block: var(--sp-6); }.hero__grid, .cards, .more, .focus, .hero__proof { grid-template-columns: 1fr; }.hero__proof { max-width: 20rem; }.hero__frame { order: -1; max-width: 12rem; justify-self: start; }.entry__head { flex-direction: column; gap: var(--sp-1); }.entry__when { text-align: left; }.skills__row { grid-template-columns: 1fr; gap: var(--sp-1); } } @media (max-width: 420px) { .hero__actions .btn { width: 100%; }.hero__proof { max-width: none; }.entry { padding-left: var(--sp-3); } }
  .hero__frame::after { content: '● Open to collaboration'; position: absolute; right: -1rem; bottom: 1rem; max-width: calc(100% - 1rem); padding: .625rem .75rem; color: var(--accent); background: var(--bg); border: 1px solid var(--accent); box-shadow: .375rem .375rem 0 var(--accent-2); font-family: var(--font-mono); font-size: .6875rem; line-height: 1.25; }
</style>

<style>
  .hero__proof { gap: 0; overflow: hidden; background: transparent; border: 1px solid var(--border); border-radius: 1rem; box-shadow: 0 8px 24px rgba(22, 22, 22, 0.06); }
  .hero__proof li { border: 0; border-right: 1px solid var(--border); }
  .hero__proof li:last-child { border-right: 0; }
  .hero__proof a { padding: var(--sp-4) 3rem var(--sp-4) var(--sp-4); }
  .hero__proof a:hover, .hero__proof a:focus-visible { transform: translateY(-2px); }
  .focus { gap: 0; overflow: hidden; background: var(--border); border: 1px solid var(--border); border-radius: 0; }
  .focus > div { position: relative; min-height: 12rem; overflow: hidden; background: var(--bg); border: 0; border-radius: 0; box-shadow: none; transition: background var(--dur) var(--ease); }
  .focus > div:not(:last-child) { border-right: 1px solid var(--border); }
  .focus > div::after { content: '↗'; position: absolute; right: var(--sp-3); bottom: var(--sp-3); color: var(--accent); opacity: 0; transform: translate(-.25rem, .25rem); transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .focus > div:hover { background: var(--accent-tint); transform: none; box-shadow: none; }
  .focus > div:hover::after { opacity: 1; transform: none; }
  .focus .mono { color: var(--accent); }
  .stack-label { color: var(--text); font-size: .8125rem; font-weight: 700; }
  .more { gap: var(--sp-4); }
  .more__panel { padding-top: 0; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
  .more__panel:hover { transform: none; box-shadow: none; border-color: var(--border-strong); }
  .plain li { padding: var(--sp-2) 0; border-radius: 0; border-bottom: 1px solid var(--border); transition: color var(--dur) var(--ease), padding var(--dur) var(--ease); }
  .plain li:hover { padding-left: var(--sp-2); background: transparent; color: var(--accent); }
  .plain--languages li { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2); }
  .more__level { flex: none; padding: .125rem .5rem; color: var(--accent); background: var(--accent-tint); border-radius: 999px; font-family: var(--font-mono); font-size: .6875rem; }
  .more__level--fluent { color: #0e6027; background: #d9f7be; }
  :global([data-theme='dark']) .more__level--fluent { color: #a7f0ba; background: #0e3b1d; }
  @media (max-width: 768px) { .hero__proof li { border-right: 0; border-bottom: 1px solid var(--border); } .hero__proof li:last-child { border-bottom: 0; } .focus > div:not(:last-child) { border-right: 0; border-bottom: 1px solid var(--border); } }
</style>
