---
import { copy, profile, type Locale } from '../data/profile';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const text = copy[locale];
const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="footer__factory" aria-hidden="true"></div>
  <svg class="footer__robot-arm footer__robot-arm--left" viewBox="0 0 280 210" aria-hidden="true">
    <g class="robot-arm__upper"><path d="M42 176 L118 112" /><circle cx="42" cy="176" r="14" /><circle cx="118" cy="112" r="10" />
      <g class="robot-arm__forearm"><path d="M118 112 L188 142" /><circle cx="188" cy="142" r="8" /><path class="robot-arm__gripper" d="M186 142 l28 -12 m-28 12 l24 18 m4 -30 l10 -14 m-10 14 l16 3" /></g>
    </g>
    <path class="robot-arm__base" d="M18 195h48l-8-19H26z" />
  </svg>
  <div class="footer__data-flow" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="container footer__inner">
    <div>
      <p class="mono">{text.labels.contact}</p>
      <h2 class="footer__headline">{text.footerHeadline}</h2>
      <a class="footer__mail link" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
    <ul class="footer__links">
      {profile.links.map((l) => (
        <li><a class="link" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>
      ))}
      <li><a class="link" href={profile.cv} target="_blank" rel="noopener">CV (PDF) ↗</a></li>
    </ul>
  </div>
  <div class="container footer__meta">
    <span class="mono">© {year} {profile.name}</span>
    <span class="mono">{profile.location}</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    margin-top: var(--sp-9);
    color: #fff;
    background: #001d3d;
    border-top: 1px solid var(--accent);
  }
  .footer__factory {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.72;
    background-image: linear-gradient(90deg, rgba(0, 17, 65, .82), rgba(0, 43, 117, .56) 55%, rgba(0, 17, 65, .8)), url('/industrial-robotics-factory.png');
    background-position: center, 44% 58%;
    background-size: cover, cover;
    animation: footer-factory-pan 26s ease-in-out infinite alternate;
  }
  .footer__factory::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 76% 32%, rgba(66, 190, 255, 0.28), transparent 22%);
    animation: footer-factory-pulse 7s ease-in-out infinite alternate;
  }
  .footer__factory::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 34%, rgba(161, 214, 255, .25) 50%, transparent 66%);
    transform: translateX(-100%);
    animation: footer-factory-scan 10s var(--ease) infinite;
  }
  .footer__robot-arm {
    position: absolute;
    z-index: 0;
    width: clamp(13rem, 24vw, 21rem);
    color: rgba(161, 214, 255, 0.48);
    fill: none;
    stroke: currentColor;
    stroke-width: 8;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    opacity: 0.48;
    filter: drop-shadow(0 0 8px rgba(15, 98, 254, 0.38));
  }
  .footer__robot-arm--left { left: -2.5rem; bottom: -1rem; }
  .robot-arm__upper { transform-box: fill-box; transform-origin: 18% 82%; animation: robot-arm-sweep 9s ease-in-out infinite alternate; }
  .robot-arm__forearm { transform-box: fill-box; transform-origin: 18% 18%; animation: robot-arm-reach 6s ease-in-out infinite alternate; }
  .robot-arm__base { fill: rgba(15, 98, 254, 0.34); stroke-width: 3; }
  .footer__data-flow {
    position: absolute;
    z-index: 0;
    right: 8%;
    bottom: 20%;
    display: flex;
    gap: 3.25rem;
    width: min(25vw, 20rem);
    height: 1px;
    background: rgba(161, 214, 255, 0.24);
    pointer-events: none;
  }
  .footer__data-flow span {
    width: 0.42rem;
    height: 0.42rem;
    margin-top: -0.18rem;
    border-radius: 50%;
    background: #a6e3ff;
    box-shadow: 0 0 0.75rem #42beff;
    animation: footer-data-flow 5.5s linear infinite;
  }
  .footer__data-flow span:nth-child(2) { animation-delay: -1.8s; }
  .footer__data-flow span:nth-child(3) { animation-delay: -3.6s; }
  @keyframes robot-arm-sweep { from { transform: rotate(-4deg); } to { transform: rotate(6deg); } }
  @keyframes robot-arm-reach { from { transform: rotate(-9deg); } to { transform: rotate(10deg); } }
  @keyframes footer-factory-pulse { from { opacity: 0.32; transform: scale(.94); } to { opacity: 0.9; transform: scale(1.08); } }
  @keyframes footer-data-flow { 0% { transform: translateX(-1rem); opacity: 0; } 15%, 70% { opacity: 1; } 100% { transform: translateX(14rem); opacity: 0; } }
  @keyframes footer-factory-pan { from { background-position: center, 44% 58%; } to { background-position: center, 56% 58%; } }
  @keyframes footer-factory-scan { 0%, 35% { transform: translateX(-100%); } 55%, 100% { transform: translateX(100%); } }
  .footer__inner,
  .footer__meta {
    position: relative;
    z-index: 1;
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-6);
    padding-block: var(--sp-8) var(--sp-6);
  }
  .footer__headline {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-block: var(--sp-2) var(--sp-4);
  }
  .footer__mail {
    font-size: 1.125rem;
    color: #fff;
  }
  .footer .mono { color: #c6e4ff; }
  .footer .link { color: #d0e2ff; }
  .footer .link:hover { color: #fff; }
  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding-top: var(--sp-6);
  }
  .footer__links .link {
    display: flex;
    align-items: center;
    min-width: 12.75rem;
    padding: 0.75rem 0.875rem;
    color: #d0e2ff;
    background: rgba(0, 29, 61, 0.9);
    border: 1px solid rgba(208, 226, 255, 0.72);
    box-shadow: 4px 4px 0 rgba(69, 137, 255, 0.78);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: transform var(--dur) var(--ease), background var(--dur) var(--ease), box-shadow var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .footer__links .link:hover,
  .footer__links .link:focus-visible {
    color: #fff;
    background: #0f62fe;
    border-color: #fff;
    box-shadow: 7px 7px 0 rgba(161, 214, 255, 0.8);
    transform: translate(-3px, -3px);
  }
  .footer__meta {
    display: flex;
    justify-content: space-between;
    padding-block: var(--sp-4);
  }
  @media (max-width: 640px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
    .footer__links {
      padding-top: 0;
    }
  }
  @media (max-width: 640px) { .footer__robot-arm { opacity: 0.22; } .footer__data-flow { right: 1rem; bottom: 14%; } }
  @media (prefers-reduced-motion: reduce) { .footer__factory, .footer__factory::before, .footer__factory::after, .robot-arm__upper, .robot-arm__forearm, .footer__data-flow span { animation: none; } }
</style>
