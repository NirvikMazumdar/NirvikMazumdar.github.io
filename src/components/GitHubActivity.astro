---
import type { Locale } from '../data/profile';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const username = 'NirvikMazumdar';
const profileUrl = `https://github.com/${username}`;
const text: Record<Locale, { eyebrow: string; title: string; description: string; action: string }> = {
  en: { eyebrow: 'GitHub activity', title: 'Public work and contributions', description: 'View the current contribution history and public repositories directly on GitHub.', action: 'Open GitHub' },
  de: { eyebrow: 'GitHub-Aktivitaet', title: 'Oeffentliche Arbeit und Beitraege', description: 'Aktuelle Beitragsverlaeufe und oeffentliche Repositories direkt auf GitHub ansehen.', action: 'GitHub oeffnen' },
  fr: { eyebrow: 'Activite GitHub', title: 'Travaux et contributions publics', description: 'Consultez l historique actuel des contributions et les depots publics directement sur GitHub.', action: 'Ouvrir GitHub' },
  nl: { eyebrow: 'GitHub-activiteit', title: 'Openbaar werk en bijdragen', description: 'Bekijk de actuele bijdragegeschiedenis en openbare repositories rechtstreeks op GitHub.', action: 'GitHub openen' },
};
const copy = text[locale];
---

<a class="activity" href={profileUrl} target="_blank" rel="noopener" aria-label={`Open ${username}'s GitHub profile`}>
  <div class="activity__head">
    <div>
      <p class="mono">{copy.eyebrow}</p>
      <h3>{copy.title}</h3>
    </div>
    <span class="activity__link">Open GitHub ↗</span>
  </div>
  <p class="activity__description muted">{copy.description}</p>
</a>

<style>
  .activity {
    position: relative;
    display: block;
    padding: var(--sp-4);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: 0;
    box-shadow: 4px 4px 0 var(--accent-2);
    transition: transform var(--dur) var(--ease), background var(--dur) var(--ease), border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .activity:hover { background: var(--accent-tint); border-color: var(--accent); transform: translate(-3px, -3px); box-shadow: 7px 7px 0 var(--accent-2); }
  .activity__head { display: flex; justify-content: space-between; gap: var(--sp-3); margin-bottom: var(--sp-5); }
  .activity h3 { margin-top: var(--sp-2); font-size: 1.125rem; }
  .activity__link { padding: 0.5rem 0.75rem; color: var(--accent); background: var(--bg); border: 1px solid var(--accent); box-shadow: 3px 3px 0 var(--accent-2); font-family: var(--font-mono); font-size: 0.75rem; white-space: nowrap; transition: color var(--dur) var(--ease), background var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .activity:hover .activity__link { color: var(--on-accent); background: var(--accent); box-shadow: 5px 5px 0 var(--accent-2); transform: translate(-2px, -2px); }
  .activity__description { max-width: 42rem; margin: 0; }
  @media (max-width: 640px) { .activity__head { flex-direction: column; gap: var(--sp-2); } }
</style>
