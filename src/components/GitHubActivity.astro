---
const username = 'NirvikMazumdar';
const profileUrl = `https://github.com/${username}`;
const chartUrl = `https://ghchart.xqsit94.in/light:0f62fe/${username}`;
---

<a class="activity" href={profileUrl} target="_blank" rel="noopener" aria-label={`Open ${username}'s GitHub profile`}>
  <div class="activity__head">
    <div>
      <p class="mono">GitHub activity</p>
      <h3>Live public contribution history</h3>
    </div>
    <span class="activity__link">Open GitHub ↗</span>
  </div>
  <img src={chartUrl} alt={`GitHub contribution graph for ${username}, refreshed by the chart provider`} loading="lazy" referrerpolicy="no-referrer" />
</a>

<style>
  .activity {
    position: relative;
    display: block;
    padding: var(--sp-4);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: 0;
    box-shadow: 4px 4px 0 var(--accent-2);
    transition: transform var(--dur) var(--ease), background var(--dur) var(--ease), border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .activity:hover { background: var(--accent-tint); border-color: var(--accent); transform: translate(-3px, -3px); box-shadow: 7px 7px 0 var(--accent-2); }
  .activity__head { display: flex; justify-content: space-between; gap: var(--sp-3); margin-bottom: var(--sp-5); }
  .activity h3 { margin-top: var(--sp-2); font-size: 1.125rem; }
  .activity__link { padding: 0.5rem 0.75rem; color: var(--accent); background: var(--bg); border: 1px solid var(--accent); box-shadow: 3px 3px 0 var(--accent-2); font-family: var(--font-mono); font-size: 0.75rem; white-space: nowrap; transition: color var(--dur) var(--ease), background var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .activity:hover .activity__link { color: var(--on-accent); background: var(--accent); box-shadow: 5px 5px 0 var(--accent-2); transform: translate(-2px, -2px); }
  .activity img { width: 100%; height: auto; min-height: 7rem; object-fit: contain; object-position: left; }
  @media (max-width: 640px) { .activity__head { flex-direction: column; gap: var(--sp-2); } .activity img { overflow-x: auto; } }
</style>
