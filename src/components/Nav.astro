---
import { copy, localePath, profile, type Locale } from '../data/profile';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const labels = copy[locale].labels;
const nav = [
  { label: labels.about, href: '#about' },
  { label: labels.experience, href: '#experience' },
  { label: labels.projects, href: '#projects' },
  { label: labels.education, href: '#education' },
  { label: labels.skills, href: '#skills' },
  { label: labels.contact, href: '#contact' },
];
---

<header class="nav">
  <div class="container nav__inner">
    <a href={localePath(locale)} class="nav__brand">{profile.name}</a>
    <nav class="nav__links" aria-label="Primary">
      {nav.map((item) => <a href={`${localePath(locale)}${item.href}`}>{item.label}</a>)}
    </nav>
    <details class="nav__language">
      <summary aria-label="Change language">Language</summary>
      <div class="nav__language-menu">
        <a href="/" aria-current={locale === 'en' ? 'page' : undefined}>English</a>
        <a href="/de/" aria-current={locale === 'de' ? 'page' : undefined}>Deutsch</a>
        <a href="/fr/" aria-current={locale === 'fr' ? 'page' : undefined}>Français</a>
        <a href="/nl/" aria-current={locale === 'nl' ? 'page' : undefined}>Nederlands</a>
      </div>
    </details>
    <button class="nav__theme" id="theme-toggle" aria-label="Toggle colour theme" title="Toggle theme">
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="8" cy="8" r="3.25" />
        <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" />
      </svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7z" />
      </svg>
    </button>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--nav-h);
    isolation: isolate;
    background: var(--nav-bg);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    width: 18rem;
    height: 100%;
    background: radial-gradient(ellipse at 100% 0%, rgba(36, 161, 72, 0.18), transparent 72%);
    filter: blur(0.5rem);
    opacity: 0.62;
    pointer-events: none;
  }
  .nav__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    height: 100%;
    gap: var(--sp-5);
  }
  .nav__brand {
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav__links {
    display: flex;
    gap: var(--sp-4);
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav__links::-webkit-scrollbar {
    display: none;
  }
  .nav__links a {
    position: relative;
    padding: 0.25rem 0.375rem;
    margin-inline: -0.375rem;
    font-size: 0.8125rem;
    color: var(--text-2);
    white-space: nowrap;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--accent);
    background: var(--accent-tint);
  }
  .nav__links a.is-active::after {
    transform: scaleX(1);
  }
  .nav__theme {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--text-2);
    background: transparent;
    transition: color var(--dur) var(--ease), filter var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .nav__language {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .nav__language summary {
    list-style: none;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--border);
    color: var(--text-2);
    cursor: pointer;
  }
  .nav__language summary::-webkit-details-marker { display: none; }
  .nav__language summary::before { content: '◎'; margin-right: 0.4rem; color: var(--accent); }
  .nav__language summary:hover,
  .nav__language[open] summary {
    color: var(--accent);
    background: var(--accent-tint);
    border-color: var(--accent);
  }
  .nav__language-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    display: grid;
    min-width: 9rem;
    padding: 0.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .nav__language a {
    padding: 0.5rem 0.625rem;
    color: var(--text-3);
  }
  .nav__language a:hover,
  .nav__language a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-tint);
  }
  .nav__theme:hover {
    background: transparent;
    transform: scale(1.08);
  }
  .nav__theme .icon-sun { color: #f1c21b; }
  .nav__theme .icon-moon { color: #4589ff; }
  .nav__theme:hover .icon-sun { color: #ffdf00; filter: drop-shadow(0 0 0.4rem rgba(255, 223, 0, 0.72)); }
  .nav__theme:hover .icon-moon { color: #a6c8ff; filter: drop-shadow(0 0 0.4rem rgba(166, 200, 255, 0.78)); }
  :global([data-theme='light']) .icon-sun,
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (max-width: 640px) {
    .nav__links {
      display: none; /* section anchors are reachable by scrolling on mobile */
    }
    .nav__theme {
      margin-left: auto;
    }
    .nav__language { margin-left: auto; }
    .nav__theme {
      margin-left: 0;
    }
  }
</style>
