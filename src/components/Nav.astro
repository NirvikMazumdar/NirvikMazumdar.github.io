---
import { profile, nav } from '../data/profile';
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand">{profile.name}</a>
    <nav class="nav__links" aria-label="Primary">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <button class="nav__theme" id="theme-toggle" aria-label="Toggle colour theme" title="Toggle theme">
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="8" cy="8" r="3.25" />
        <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" />
      </svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7z" />
      </svg>
    </button>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--nav-h);
    background: var(--nav-bg);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: var(--sp-5);
  }
  .nav__brand {
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav__links {
    display: flex;
    gap: var(--sp-4);
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav__links::-webkit-scrollbar {
    display: none;
  }
  .nav__links a {
    position: relative;
    font-size: 0.8125rem;
    color: var(--text-2);
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--text);
  }
  .nav__links a.is-active::after {
    transform: scaleX(1);
  }
  .nav__theme {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--text-2);
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .nav__theme:hover {
    color: var(--text);
    background: var(--bg-hover);
  }
  :global([data-theme='light']) .icon-sun,
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (max-width: 640px) {
    .nav__links {
      display: none; /* section anchors are reachable by scrolling on mobile */
    }
    .nav__theme {
      margin-left: auto;
    }
  }
</style>
