---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollControl from '../components/ScrollControl.astro';
import { copy, profile, type Locale } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const { title, locale = 'en' } = Astro.props;
const text = copy[locale];
const pageDescription = Astro.props.description || text.summary;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} — ${text.tagline}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={profile.photo} />
    <!-- Apply theme before first paint to avoid a flash -->
    <script is:inline>
      // Light by default; dark only when the visitor has toggled it.
      document.documentElement.dataset.theme = localStorage.getItem('theme') || 'light';
    </script>
  </head>
  <body>
    <Nav locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <ScrollControl />
    <script>
      // Reveal-on-scroll
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              revealObserver.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

      // Highlight the nav link for the section currently in view
      const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav__links a[href*="#"]')];
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            navLinks.forEach((a) => a.classList.toggle('is-active', a.hash === `#${e.target.id}`));
          }
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      navLinks.forEach((a) => {
        const target = document.getElementById(a.hash.slice(1));
        if (target) sectionObserver.observe(target);
      });

      // The three profile panels are compact route cards: sensing and learning
      // point to projects, while deployment points to relevant work experience.
      document.querySelectorAll<HTMLElement>('.focus > div').forEach((panel, index, panels) => {
        const targetId = index === panels.length - 1 ? 'experience' : 'projects';
        panel.setAttribute('role', 'link');
        panel.tabIndex = 0;
        panel.setAttribute('aria-label', `View ${targetId}`);
        const openTarget = () => document.getElementById(targetId)?.scrollIntoView({ behavior: 'smooth' });
        panel.addEventListener('click', openTarget);
        panel.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openTarget();
          }
        });
      });

      // Display official institutional marks next to the two education entries.
      const institutionLogos: Record<string, string> = {
        'RWTH Aachen University': 'https://www.rwth-aachen.de/global/show_picture.asp?id=aaaaaaaaaaagazb',
        'Institute of Engineering & Management (IEM)': '/iem-logo.jpg',
      };
      document.querySelectorAll<HTMLElement>('.entry__head .muted').forEach((school) => {
        const logoUrl = institutionLogos[school.textContent?.trim() || ''];
        if (!logoUrl) return;
        const logo = document.createElement('img');
        logo.className = 'entry__logo';
        logo.src = logoUrl;
        logo.alt = `${school.textContent?.trim()} logo`;
        logo.loading = 'lazy';
        school.parentElement?.insertBefore(logo, school);
      });

      const roleIcons = [
        '<path d="M4 8h12v8H4zM7 8V5h6v3M8 12h4M10 10v4"/>',
        '<circle cx="10" cy="10" r="5"/><circle cx="10" cy="10" r="1.5"/><path d="M10 2v2M10 16v2M2 10h2M16 10h2"/>',
        '<path d="M3 12h3l2-7 3 10 2-5h4"/>',
      ];
      const educationIcon = '<path d="m2 8 8-4 8 4-8 4-8-4Z"/><path d="M5 10v4c2 2 8 2 10 0v-4M18 8v5"/>';
      document.querySelectorAll<HTMLElement>('#experience .entry__head h3, #education .entry__head h3').forEach((title, index) => {
        const isEducation = title.closest('#education') !== null;
        const icon = document.createElement('span');
        icon.className = isEducation ? 'entry__role-icon entry__role-icon--education' : 'entry__role-icon';
        icon.setAttribute('aria-hidden', 'true');
        icon.innerHTML = `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">${isEducation ? educationIcon : roleIcons[index] || roleIcons[0]}</svg>`;
        const row = document.createElement('div');
        row.className = 'entry__title';
        title.before(row);
        row.append(icon, title);
      });

      const featuredSkills = new Set(['Python', 'C++', 'ROS', 'Fastify / Node.js', 'PostgreSQL', 'ThingsBoard', 'MQTT', 'Thread', 'Grafana', 'Docker']);
      document.querySelectorAll<HTMLElement>('.tag').forEach((tag) => {
        if (featuredSkills.has(tag.textContent?.trim() || '')) tag.classList.add('tag--featured');
      });

      const keyTerms = /(Robotic Systems Engineering|machine learning|embedded systems|IoT|control engineering|real-time firmware|sensor integration|radar systems|digital twins|backend|data architectures|ThingsBoard|MQTT|Thread|REST APIs|60 GHz FMCW radar)/gi;
      document.querySelectorAll<HTMLElement>('.lead').forEach((lead) => {
        const walker = document.createTreeWalker(lead, NodeFilter.SHOW_TEXT);
        const textNodes: Text[] = [];
        while (walker.nextNode()) textNodes.push(walker.currentNode as Text);
        textNodes.forEach((node) => {
          const value = node.nodeValue || '';
          if (!keyTerms.test(value)) return;
          keyTerms.lastIndex = 0;
          const fragment = document.createDocumentFragment();
          value.split(keyTerms).forEach((part) => {
            if (!part) return;
            if (keyTerms.test(part)) {
              const emphasis = document.createElement('strong');
              emphasis.className = 'lead__key';
              emphasis.textContent = part;
              fragment.append(emphasis);
              keyTerms.lastIndex = 0;
            } else {
              fragment.append(document.createTextNode(part));
            }
          });
          node.replaceWith(fragment);
        });
      });
    </script>
  </body>
</html>
