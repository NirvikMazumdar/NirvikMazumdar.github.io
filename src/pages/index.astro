---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import { getSkillHref, profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__glow hero__glow--1" aria-hidden="true"></div>
    <div class="hero__glow hero__glow--2" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="mono hero__loc">{profile.location}</p>
        <h1 class="hero__title">
          <span class="gradient-text">{profile.headline}</span>
        </h1>
        <p class="hero__tagline muted">{profile.tagline}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={profile.cv} target="_blank" rel="noopener">
            Download CV <span aria-hidden="true">↓</span>
          </a>
          {profile.links.map((l) => (
            <a class="btn btn--terminal" href={l.href} target="_blank" rel="noopener">
              {l.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <ul class="hero__proof" aria-label="Career highlights">
          <li><a href="#projects"><strong>ROS + C++</strong><span>robotics software foundation</span></a></li>
          <li><a href="#projects"><strong>IMU + firmware</strong><span>embedded sensing prototypes</span></a></li>
          <li><a href="#projects"><strong>ML control</strong><span>learning and optimisation systems</span></a></li>
        </ul>
        <a class="hero__scroll mono" href="#projects">View selected work <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero__frame">
        <img class="hero__photo" src={profile.photo} alt={`Portrait of ${profile.name}`} width="480" height="640" />
        <p class="hero__availability"><span aria-hidden="true"></span>Open to collaboration</p>
      </div>
    </div>
  </section>

  <!-- About -->
  <Section id="about" index="01" label="About">
    <p class="lead">{profile.summary}</p>
    <div class="focus" aria-label="Robotics profile at a glance">
      <div>
        <p class="mono">01 / SENSE</p>
        <h3>Embedded sensing</h3>
        <p>IMU-based interaction prototypes, Arduino and real-time signal handling.</p>
      </div>
      <div>
        <p class="mono">02 / DECIDE</p>
        <h3>Control & learning</h3>
        <p>Model-based control, simulation and machine-learning evaluation.</p>
      </div>
      <div>
        <p class="mono">03 / DEPLOY</p>
        <h3>Systems integration</h3>
        <p>Firmware, APIs and data platforms connected to real devices.</p>
      </div>
    </div>
    <p class="mono stack-label">Primary tech stack</p>
    <ul class="chips">
      {profile.stack.map((s) => <li><a class="tag" href={getSkillHref(s)}>{s}</a></li>)}
    </ul>
  </Section>

  <!-- Experience -->
  <Section id="experience" index="02" label="Experience">
    <ul class="timeline">
      {profile.experience.map((job) => (
        <li class="entry">
          <div class="entry__head">
            <div>
              <h3>{job.role}</h3>
              <p class="muted">{job.org}</p>
            </div>
            <p class="mono entry__when">{job.period}<br />{job.location}</p>
          </div>
          <ul class="bullets">
            {job.bullets.map((b) => <li>{b}</li>)}
          </ul>
          {job.tools.length > 0 && (
            <ul class="chips">
              {job.tools.map((t) => <li><a class="tag" href={getSkillHref(t)}>{t}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- Projects -->
  <Section id="projects" index="03" label="Projects">
    <div class="cards">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </Section>

  <Section id="activity" index="04" label="GitHub">
    <GitHubActivity />
  </Section>

  <!-- Education -->
  <Section id="education" index="05" label="Education">
    <ul class="timeline">
      {profile.education.map((ed) => (
        <li class="entry">
          <div class="entry__head">
            <div>
              <h3>{ed.degree}</h3>
              <p class="muted">{ed.school}</p>
            </div>
            <p class="mono entry__when">{ed.period}</p>
          </div>
          {ed.notes.length > 0 && (
            <ul class="bullets">
              {ed.notes.map((n) => <li>{n}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- Skills -->
  <Section id="skills" index="06" label="Skills">
    <dl class="skills">
      {profile.skills.map((s) => (
        <div class="skills__row">
          <dt class="mono">{s.group}</dt>
          <dd>{s.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <!-- More -->
  <Section id="more" index="07" label="More">
    <div class="more">
      <div class="more__panel">
        <p class="mono">Languages</p>
        <ul class="plain plain--languages">
          {profile.languages.map((l) => <li><span>{l.name}</span><span class:list={['more__level', { 'more__level--fluent': !l.level.startsWith('A2') }]}>{l.level}</span></li>)}
        </ul>
      </div>
      <div class="more__panel">
        <p class="mono">Achievements & volunteering</p>
        <ul class="plain">
          {profile.achievements.map((a) => <li>{a}</li>)}
        </ul>
      </div>
      <div class="more__panel">
        <p class="mono">Interests</p>
        <ul class="plain">
          {profile.interests.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </Section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--sp-8) var(--sp-7);
  }
  .hero__glow {
    position: absolute;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    filter: blur(100px);
    display: none;
    pointer-events: none;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .hero__glow--1 {
    top: -12rem;
    left: -8rem;
    background: #a7f3b5;
  }
  .hero__glow--2 {
    right: -10rem;
    bottom: -16rem;
    background: var(--text-3);
    opacity: 0.08;
    animation-delay: -9s;
  }
  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(4rem, 3rem) scale(1.15); }
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--sp-6);
    align-items: center;
  }
  .hero__text {
    animation: rise 700ms var(--ease) both;
  }
  .hero__frame {
    animation: rise 700ms var(--ease) 150ms both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
  .hero__loc {
    color: var(--accent);
  }
  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-block: var(--sp-3) var(--sp-4);
    max-width: 16ch;
  }
  .hero__tagline {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.4;
    max-width: 40ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
  }
  .hero__proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: var(--sp-6);
    max-width: 44rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    box-shadow: 0 8px 24px rgba(22, 22, 22, 0.06);
    animation: rise 600ms var(--ease) 220ms both;
  }
  .hero__proof li {
    background: var(--bg);
    border-right: 1px solid var(--border);
  }
  .hero__proof li:last-child { border-right: 0; }
  .hero__proof a {
    position: relative;
    display: grid;
    gap: var(--sp-1);
    height: 100%;
    padding: var(--sp-4) 3rem var(--sp-4) var(--sp-4);
    overflow: hidden;
    transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .hero__proof a::after {
    content: '↘';
    position: absolute;
    right: var(--sp-3);
    bottom: var(--sp-3);
    color: var(--accent);
    opacity: 0;
    transform: translate(-0.25rem, -0.25rem);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .hero__proof a:hover,
  .hero__proof a:focus-visible {
    background: var(--accent-tint);
    transform: translateY(-2px);
  }
  .hero__proof a:hover::after,
  .hero__proof a:focus-visible::after { opacity: 1; transform: none; }
  .hero__proof strong {
    color: var(--accent);
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .hero__proof span {
    color: var(--text-2);
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .hero__scroll {
    display: inline-flex;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
    color: var(--text-2);
  }
  .hero__scroll:hover { color: var(--accent); }
  .hero__frame {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 22rem;
  }
  /* Offset accent frame behind the photo */
  .hero__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(1rem, 1rem);
    background: #a7f3b5;
    border-radius: var(--radius);
    z-index: -1;
    transition: transform 300ms var(--ease);
  }
  .hero__frame:hover::before {
    transform: translate(0.5rem, 0.5rem);
  }
  .hero__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 72%;
    border-radius: var(--radius);
  }
  .hero__availability {
    position: absolute;
    right: -1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: calc(100% - 1rem);
    margin: 0;
    padding: 0.625rem 0.75rem;
    color: var(--accent);
    background: var(--bg);
    border: 1px solid var(--accent);
    box-shadow: 0.375rem 0.375rem 0 var(--accent-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.25;
  }
  .hero__availability span {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #b7ffca;
    box-shadow: 0 0 0.35rem #b7ffca, 0 0 0.9rem #42be65;
  }

  /* About */
  .lead {
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.5;
    max-width: 44rem;
  }
  .stack-label {
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-2);
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .focus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: var(--sp-5);
    border: 1px solid var(--border);
    background: var(--border);
  }
  .focus > div {
    position: relative;
    min-height: 12rem;
    padding: var(--sp-4);
    overflow: hidden;
    background: var(--bg);
    transition: background var(--dur) var(--ease);
  }
  .focus > div:not(:last-child) { border-right: 1px solid var(--border); }
  .focus > div::after { content: '↗'; position: absolute; right: var(--sp-3); bottom: var(--sp-3); color: var(--accent); opacity: 0; transform: translate(-.25rem, .25rem); transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .focus > div:hover {
    background: var(--accent-tint);
  }
  .focus > div:hover::after { opacity: 1; transform: none; }
  .focus h3 {
    margin-block: var(--sp-3) var(--sp-2);
    font-size: 1.125rem;
  }
  .focus .mono { color: var(--accent); }
  .focus p:last-child { color: var(--text-2); font-size: 0.9375rem; }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }

  /* Timeline entries */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-left: var(--sp-4);
    border-left: 2px solid var(--border);
    transition: border-color var(--dur) var(--ease);
  }
  .entry:hover {
    border-left-color: var(--accent);
  }
  .entry__head {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .entry__head h3 {
    font-size: 1.25rem;
  }
  .entry__when {
    text-align: right;
    flex: none;
    line-height: 1.6;
  }
  .bullets {
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--text-2);
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    max-width: 44rem;
  }

  /* Project cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-3);
  }

  /* Skills */
  .skills {
    margin: 0;
  }
  .skills__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-2);
    border-bottom: 1px solid var(--border);
    transition: background var(--dur) var(--ease);
  }
  .skills__row:hover {
    background: var(--accent-tint);
  }
  .skills__row:hover dt {
    color: var(--accent);
  }
  .skills__row:first-child {
    border-top: 1px solid var(--border);
  }
  .skills dt {
    align-self: center;
  }
  .skills dd {
    margin: 0;
  }

  /* More */
  .more {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-4);
  }
  .more__panel {
    padding-top: 0;
  }
  .plain {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin-top: var(--sp-2);
  }
  .plain li {
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--border);
    transition: color var(--dur) var(--ease), padding var(--dur) var(--ease);
  }
  .plain li:hover { padding-left: var(--sp-2); color: var(--accent); }
  .plain--languages li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .more__level {
    flex: none;
    padding: 0.125rem 0.5rem;
    color: var(--accent);
    background: var(--accent-tint);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
  .more__level--fluent { color: #0e6027; background: #d9f7be; }
  :global([data-theme='dark']) .more__level--fluent { color: #a7f0ba; background: #0e3b1d; }

  @media (max-width: 768px) {
    .hero {
      padding-block: var(--sp-6);
    }
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__frame {
      order: -1;
      max-width: 12rem;
      justify-self: start;
    }
    .hero__proof {
      grid-template-columns: 1fr;
      max-width: 20rem;
    }
    .hero__proof li { border-right: 0; border-bottom: 1px solid var(--border); }
    .hero__proof li:last-child { border-bottom: 0; }
    .hero__glow {
      width: 20rem;
      height: 20rem;
    }
    .cards,
    .more,
    .focus {
      grid-template-columns: 1fr;
    }
    .focus > div:not(:last-child) { border-right: 0; border-bottom: 1px solid var(--border); }
    .entry__head {
      flex-direction: column;
      gap: var(--sp-1);
    }
    .entry__when {
      text-align: left;
    }
    .skills__row {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
  @media (max-width: 420px) {
    .hero__actions .btn { width: 100%; }
    .hero__proof { max-width: none; }
    .entry { padding-left: var(--sp-3); }
  }
</style>
