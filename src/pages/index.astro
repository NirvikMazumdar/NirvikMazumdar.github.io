---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__glow hero__glow--1" aria-hidden="true"></div>
    <div class="hero__glow hero__glow--2" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="mono hero__loc">{profile.location}</p>
        <h1 class="hero__title">
          <span class="gradient-text">{profile.headline}</span>
        </h1>
        <p class="hero__tagline muted">{profile.tagline}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={profile.cv} target="_blank" rel="noopener">
            Download CV <span aria-hidden="true">↓</span>
          </a>
          {profile.links.map((l) => (
            <a class="btn btn--ghost" href={l.href} target="_blank" rel="noopener">
              {l.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
      <div class="hero__frame">
        <img class="hero__photo" src={profile.photo} alt={`Portrait of ${profile.name}`} width="480" height="640" />
      </div>
    </div>
  </section>

  <!-- About -->
  <Section id="about" index="01" label="About">
    <p class="lead">{profile.summary}</p>
    <p class="mono stack-label">Primary tech stack</p>
    <ul class="chips">
      {profile.stack.map((s) => <li class="tag">{s}</li>)}
    </ul>
  </Section>

  <!-- Experience -->
  <Section id="experience" index="02" label="Experience">
    <ul class="timeline">
      {profile.experience.map((job) => (
        <li class="entry">
          <div class="entry__head">
            <div>
              <h3>{job.role}</h3>
              <p class="muted">{job.org}</p>
            </div>
            <p class="mono entry__when">{job.period}<br />{job.location}</p>
          </div>
          <ul class="bullets">
            {job.bullets.map((b) => <li>{b}</li>)}
          </ul>
          {job.tools.length > 0 && (
            <ul class="chips">
              {job.tools.map((t) => <li class="tag">{t}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- Projects -->
  <Section id="projects" index="03" label="Projects">
    <div class="cards">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </Section>

  <!-- Education -->
  <Section id="education" index="04" label="Education">
    <ul class="timeline">
      {profile.education.map((ed) => (
        <li class="entry">
          <div class="entry__head">
            <div>
              <h3>{ed.degree}</h3>
              <p class="muted">{ed.school}</p>
            </div>
            <p class="mono entry__when">{ed.period}</p>
          </div>
          {ed.notes.length > 0 && (
            <ul class="bullets">
              {ed.notes.map((n) => <li>{n}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- Skills -->
  <Section id="skills" index="05" label="Skills">
    <dl class="skills">
      {profile.skills.map((s) => (
        <div class="skills__row">
          <dt class="mono">{s.group}</dt>
          <dd>{s.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <!-- More -->
  <Section id="more" index="06" label="More">
    <div class="more">
      <div>
        <p class="mono">Languages</p>
        <ul class="plain">
          {profile.languages.map((l) => <li>{l.name} <span class="muted">— {l.level}</span></li>)}
        </ul>
      </div>
      <div>
        <p class="mono">Achievements & volunteering</p>
        <ul class="plain">
          {profile.achievements.map((a) => <li>{a}</li>)}
        </ul>
      </div>
      <div>
        <p class="mono">Interests</p>
        <ul class="plain">
          {profile.interests.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </Section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--sp-8) var(--sp-7);
  }
  .hero__glow {
    position: absolute;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.35;
    pointer-events: none;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .hero__glow--1 {
    top: -12rem;
    left: -8rem;
    background: var(--accent);
  }
  .hero__glow--2 {
    right: -10rem;
    bottom: -16rem;
    background: var(--accent-2);
    animation-delay: -9s;
  }
  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(4rem, 3rem) scale(1.15); }
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--sp-6);
    align-items: center;
  }
  .hero__text {
    animation: rise 700ms var(--ease) both;
  }
  .hero__frame {
    animation: rise 700ms var(--ease) 150ms both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
  .hero__loc {
    color: var(--accent);
  }
  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-block: var(--sp-3) var(--sp-4);
    max-width: 16ch;
  }
  .hero__tagline {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.4;
    max-width: 40ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
  }
  .hero__frame {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 22rem;
  }
  /* Offset Carbon-blue frame behind the photo */
  .hero__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(1rem, 1rem);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-radius: var(--radius);
    z-index: -1;
    transition: transform 300ms var(--ease);
  }
  .hero__frame:hover::before {
    transform: translate(0.5rem, 0.5rem);
  }
  .hero__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* About */
  .lead {
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.5;
    max-width: 44rem;
  }
  .stack-label {
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-2);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }

  /* Timeline entries */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-left: var(--sp-4);
    border-left: 2px solid var(--border);
    transition: border-color var(--dur) var(--ease);
  }
  .entry:hover {
    border-left-color: var(--accent);
  }
  .entry__head {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .entry__head h3 {
    font-size: 1.25rem;
  }
  .entry__when {
    text-align: right;
    flex: none;
    line-height: 1.6;
  }
  .bullets {
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--text-2);
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    max-width: 44rem;
  }

  /* Project cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-3);
  }

  /* Skills */
  .skills {
    margin: 0;
  }
  .skills__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-2);
    border-bottom: 1px solid var(--border);
    transition: background var(--dur) var(--ease);
  }
  .skills__row:hover {
    background: var(--accent-tint);
  }
  .skills__row:hover dt {
    color: var(--accent);
  }
  .skills__row:first-child {
    border-top: 1px solid var(--border);
  }
  .skills dt {
    align-self: center;
  }
  .skills dd {
    margin: 0;
  }

  /* More */
  .more {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-5);
  }
  .plain {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin-top: var(--sp-2);
  }

  @media (max-width: 768px) {
    .hero {
      padding-block: var(--sp-6);
    }
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__frame {
      order: -1;
      max-width: 12rem;
      justify-self: start;
    }
    .hero__glow {
      width: 20rem;
      height: 20rem;
    }
    .cards,
    .more {
      grid-template-columns: 1fr;
    }
    .entry__head {
      flex-direction: column;
      gap: var(--sp-1);
    }
    .entry__when {
      text-align: left;
    }
    .skills__row {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
</style>
